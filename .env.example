# Copy to .env and edit.
HOSPITAL_NAME=Zamboanga Regional Medical Center
# Name of the system shown in page headers and titles
SYSTEM_NAME=ZRMC ONE Hospital System
HOSPITAL_TZ=Asia/Manila
PORT=3000

# Supabase → Connect → Connection string → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
# Leave empty for local testing: an embedded database is stored in ./data instead.
DATABASE_URL=

# Random secret for the SMS reminder endpoint (/api/cron/reminders), e.g. `openssl rand -hex 24`
CRON_SECRET=

# Admin login is created on first start only. Change the password afterwards from Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# --- Medical Records pickup ---
# Claimable this many days after the request (next working day if weekend/holiday)
RECORDS_CLAIM_DAYS=3
RECORDS_OPEN_SATURDAY=false
# Digital copies: ID and selfie photos are deleted this many days after the request is finished
ID_PHOTO_RETENTION_DAYS=30

# Attendance Monitoring: default official hours for new employees, grace period before a
# time-in counts as late, PIN lockout, and how long kiosk photos are kept
ATTENDANCE_SHIFT_START=08:00
ATTENDANCE_SHIFT_END=17:00
ATTENDANCE_GRACE_MINUTES=0
ATTENDANCE_MAX_PIN_ATTEMPTS=5
ATTENDANCE_LOCK_MINUTES=15
ATTENDANCE_PHOTO_RETENTION_DAYS=90

# --- OPD clinic slots ---
# Starting values for the first month only. After that, staff set each clinic's days, hours,
# slot length and patients per slot every month in Admin → OPD Schedules.
# OPD_MAX_DAYS_AHEAD is how far ahead patients can book.
OPD_START=08:00
OPD_END=12:00
OPD_SLOT_MINUTES=30
OPD_PATIENTS_PER_SLOT=4
OPD_OPEN_SATURDAY=false
OPD_MAX_DAYS_AHEAD=30

# --- SMS ---
# console = print to server log (testing), unisms = UniSMS (PH), semaphore = Semaphore (PH), twilio = Twilio
SMS_PROVIDER=console
# Sender ID registered with your SMS provider (optional)
SMS_SENDER_NAME=
# UniSMS secret key (from your UniSMS account)
UNISMS_API_KEY=
SEMAPHORE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Reminders: day before at this local time, and N hours before the appointment (0 = off)
REMINDER_DAY_BEFORE_TIME=17:00
REMINDER_HOURS_BEFORE=2
# Only used when running as a normal server (npm start). On Vercel, reminders run when
# your scheduler calls /api/cron/reminders.
REMINDER_INTERVAL_SEC=60
